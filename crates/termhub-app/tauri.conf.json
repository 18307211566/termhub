{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "termhub",
  "version": "0.1.0",
  "identifier": "io.github.hutaom.termhub",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --prefix ui",
    "beforeBuildCommand": "npm run build --prefix ui"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "title": "termhub",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "maximizable": false,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
