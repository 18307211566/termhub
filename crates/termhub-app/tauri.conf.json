{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "termhub",
  "version": "0.1.0",
  "identifier": "local.termhub",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --prefix ui",
    "beforeBuildCommand": "cd termhub-app/ui && npm install && npm run build"
  },
  "app": {
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "title": "termhub",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
